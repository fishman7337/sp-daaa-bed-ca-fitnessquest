{
  "name": "fitness-quest-bed-ca2",
  "version": "2.0.0",
  "description": "FitnessQuest: an Express, MySQL, and vanilla JS gamified fitness app for ST0503 Back-End Web Development CA2.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "db:create": "node scripts/db.js create",
    "db:migrate": "node scripts/db.js migrate",
    "db:seed": "node scripts/db.js seed",
    "db:reset": "node scripts/db.js reset",
    "db:reset:test": "cross-env NODE_ENV=test DB_DATABASE=fitnessquest_test node scripts/db.js reset",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "npm run db:reset:test && cross-env NODE_ENV=test DB_DATABASE=fitnessquest_test jest --runInBand",
    "test:security": "cross-env NODE_ENV=test DB_DATABASE=fitnessquest_test jest tests/security --runInBand",
    "test:e2e": "playwright test",
    "audit": "npm audit --omit=dev --audit-level=moderate",
    "check": "npm run lint && npm run format && npm run test && npm run test:e2e && npm run audit"
  },
  "keywords": [
    "nodejs",
    "express",
    "mysql",
    "jwt-auth",
    "playwright",
    "backend-web-development",
    "st0503",
    "singapore-polytechnic",
    "coursework",
    "fitness-game"
  ],
  "author": "Goh Kun Ming",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.2.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.11",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
